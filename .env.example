# The connection string is the only place the database engine is chosen.
# Copy this file to .env and adjust if needed. Never commit .env.

# Development default: one file, nothing to install.
DATABASE_URL=sqlite:///data/runtime/flowremote.db

# Later, once PostgreSQL is installed locally:
# DATABASE_URL=postgresql://flowremote:flowremote@localhost:5432/flowremote

# Key used to sign the browser session cookie. Leave it empty to have one
# generated into data/runtime/session.key on first start.
SESSION_SECRET=
