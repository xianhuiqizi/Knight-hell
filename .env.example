# The connection string is the only place the database engine is chosen.
# Copy this file to .env and adjust if needed. Never commit .env.

# Local development. Registered users persist here between application restarts.
FLOWREMOTE_STORAGE_MODE=local
# FLOWREMOTE_DATABASE_URL=sqlite:///data/runtime/flowremote.db

# Production/enterprise mode. Requires PostgreSQL and a reachable enterprise
# database. Keep credentials out of Git and grant only the needed schema rights.
# FLOWREMOTE_STORAGE_MODE=enterprise
# FLOWREMOTE_ENTERPRISE_DATABASE_URL=postgresql://user:password@db.example.com:5432/flowremote

# Legacy compatibility. FLOWREMOTE_DATABASE_URL takes precedence.
# DATABASE_URL=postgresql://flowremote:flowremote@localhost:5432/flowremote

# Key used to sign the browser session cookie. Leave it empty to have one
# generated into data/runtime/session.key on first start.
SESSION_SECRET=

# Feature 3 server defaults. Individual users can override these values in the
# AI connection window. The UI stores each user's API key encrypted at rest.
FLOWREMOTE_AI_PROVIDER=offline
FLOWREMOTE_AI_MODEL=gpt-6-astra
OPENAI_API_KEY=

# Optional path to the customer registry used to retrieve grounded candidates.
# FLOWREMOTE_CUSTOMER_REGISTRY=C:\path\to\customer_registry.csv
